{
  "name": "@zilliz/memsearch-pi",
  "version": "0.1.0",
  "description": "memsearch plugin for pi — semantic memory search across sessions",
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
