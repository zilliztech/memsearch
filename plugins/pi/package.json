    "transcript.py",
    "scripts/*.sh",
    "scripts/*.py",
    "skills/",
    "prompts/",
    "README.md"
  ],
  "keywords": [
    "pi",
    "pi-extension",
    "memsearch",
    "memory",
    "semantic-search",
    "milvus"
