  },
  "author": "memsearch contributors",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.82.0",
    "typebox": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zilliztech/memsearch",
    "directory": "plugins/pi"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "typebox": "^1.3.8"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
